[_tb_end_text]
; @end-dialogue



; @dialogue
; @source
[tb_start_text mode=1 ]
#クピャドエル
こんなことで自分を偽るなんて…[r]馬鹿馬鹿しいですよねぇ[p]
[_tb_end_text]
; @translation
[tb_start_text mode=1 ]
#クピャドエル
借此伪装自己……[r]
