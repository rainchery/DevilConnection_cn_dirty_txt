[_tb_end_text]
; @end-dialogue



; @dialogue
; @source
[tb_start_text mode=1 ]
#クピャドエル
でびくんの真のお名前を予想してみたのですぅ！[r]あくまで予想なので聞き流して貰って構わないのですが…[p]
[_tb_end_text]
; @translation
[tb_start_text mode=1 ]
#クピャドエル
