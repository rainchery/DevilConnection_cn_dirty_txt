[tb_start_text mode=1 ]
#ミンティ
ふふ、相手を惑わすのって[r]ホントたのしいわね[p]

[_tb_end_text]
; @translation
[tb_start_text mode=1 ]
#ミンティ
呼呼，迷惑对手，[r]
真的太有趣了呢。[p]

[_tb_end_text]
; @end-dialogue



; @dialogue
; @source
[tb_start_text mode=1 ]
#でびるん
ぁ…………[wait time=200][p]



[_tb_end_text]
