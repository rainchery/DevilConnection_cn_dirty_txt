#でびるん
什、什么！？[p]

[_tb_end_text]
; @end-dialogue



; @dialogue
; @source
[tb_start_text mode=1 ]
#ミンティ
悪い子には特別にサイミントクリームを[r]コーンにトッピングしてあげちゃう[p]




[_tb_end_text]
; @translation
[tb_start_text mode=1 ]
#ミンティ
对于坏孩子呢，就特意在你的甜筒上，[r]
加上催眠薄荷奶油哦～[p]




[_tb_end_text]
; @end-dialogue



; @dialogue
; @source
[tb_start_text mode=1 ]
#でびるん
ぐぬぬ・・・[r]よ、よりによってツノに[p]

[_tb_end_text]
; @translation
[tb_start_text mode=1 ]
#でびるん
咕奴奴……[r]
居、居然是涂在角上……[p]

[_tb_end_text]
; @end-dialogue



; @dialogue
; @source
[tb_start_text mode=1 ]
#ミンティ
ねぇ…そこのアナタも。[r]なめたくてたまらないでしょ？[p]
[_tb_end_text]
; @translation
[tb_start_text mode=1 ]
#ミンティ
啊……，那边的另一位客人，[r]
您是不是已经无法控制舔食的冲动了？[p]
[_tb_end_text]
; @end-dialogue



; @dialogue
; @source
[tb_start_text mode=1 ]
#でびるん
[font size=50]ぎゃあぁあぁいやだっ！[r]やめろ[emb exp="f.name"]！[resetfont][p]


[_tb_end_text]
; @translation
[tb_start_text mode=1 ]
#でびるん
[font size=50]呀啊啊啊啊不要！[r]
快住手[emb exp="f.name"]！[resetfont][p]


[_tb_end_text]
; @end-dialogue



; @dialogue
; @source
[tb_start_text mode=1 ]
#ミンティ
ほぅら、たっぷりしゃぶりなさい。[p]

[_tb_end_text]
; @translation
[tb_start_text mode=1 ]
