; @end-dialogue



; @dialogue
; @source
[tb_start_text mode=1 ]
#でびるん
お、うんみゃそーなケーキ！[r]おみゃーが作ったのかー？[p]
[_tb_end_text]
; @translation
[tb_start_text mode=1 ]
#でびるん
哇，看起来好好吃的蛋糕！[r]
是你做的吗？[p]
[_tb_end_text]
; @end-dialogue



; @dialogue
; @source
[tb_start_text mode=1 ]
#ミンティ
えぇ、普段はショコラーニュって[r]洋菓子店でパティシエをやっているの[p]
[_tb_end_text]
; @translation
[tb_start_text mode=1 ]
#ミンティ
是的，平日里我都在一家名为[r]
「巧克拉涅」的烘焙店里担当糕点师。[p]
[_tb_end_text]
; @end-dialogue



; @dialogue
