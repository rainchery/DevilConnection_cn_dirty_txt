来，尽情地舔食干净吧。[p]

[_tb_end_text]
; @end-dialogue



; @dialogue
; @source
[tb_start_text mode=1 ]
#ミンティ
[_tb_end_text]
; @translation
[tb_start_text mode=1 ]
#ミンティ
[_tb_end_text]
; @end-dialogue



; @dialogue
