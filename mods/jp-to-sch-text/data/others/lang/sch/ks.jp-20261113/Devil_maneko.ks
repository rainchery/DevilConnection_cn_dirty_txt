[tb_start_text mode=1 ]
#マネコ
[ruby text="⠀"]ジ、[ruby text="ジェネ"]七[ruby text="ラル"]大[ruby text="セブ"]悪[ruby text="ン"]魔紅一点！マネー大好き[r]マネッコ得意な招き猫マネコちゃんですの！[p]

[_tb_end_text]
; @translation
[tb_start_text mode=1 ]
