; @source
[tb_start_text mode=1 ]
#サフィール
タテガミは馬の命だ、はやく乾かさなくては[p]

[_tb_end_text]
; @translation
[tb_start_text mode=1 ]
#サフィール
鬃毛乃马之性命，须尽快弄干。[p]

[_tb_end_text]
