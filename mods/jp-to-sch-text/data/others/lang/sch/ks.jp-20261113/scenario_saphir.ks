; @dialogue
; @source
[tb_start_text mode=1 ]
#サフィール
あぁ、サインかい？[r]いいよ[p]

[_tb_end_text]
; @translation
[tb_start_text mode=1 ]
#サフィール
啊，是要签名吗？[r]
没问题。[p]

[_tb_end_text]
