; @dialogue
; @source
[tb_start_text mode=1 ]
#ミーティア
[font size=50][emb exp="f.name"]サン！[resetfont][r]ちょうど会ってお話がしたかったのデース！[p]
[_tb_end_text]
; @translation
[tb_start_text mode=1 ]
#ミーティア
[font size=50][emb exp="f.name"]！[resetfont][r]
终于能和你说上话了，太棒了的说！[p]
[_tb_end_text]
; @end-dialogue



; @dialogue
