[_tb_end_text]
; @end-dialogue



; @dialogue
; @source
[tb_start_text mode=1 ]
#ミーティア
[font size=50]ミャァー！やったデス！[r]嬉しいデース！[resetfont][p]

[_tb_end_text]
; @translation
[tb_start_text mode=1 ]
#ミーティア
[font size=50]咪呀～！太棒啦！[r]
好开心的说！[resetfont][p]

[_tb_end_text]
; @end-dialogue



; @dialogue
; @source
[tb_start_text mode=1 ]
#でびるん
おーい、[emb exp="f.name"]はまだ何も言ってねぇぞ[p]
[_tb_end_text]
; @translation
[tb_start_text mode=1 ]
#でびるん
喂，[emb exp="f.name"]还什么都没说啊。[p]
[_tb_end_text]
; @end-dialogue



; @dialogue
; @source
[tb_start_text mode=1 ]
#ミーティア
[emb exp="f.name"]サンなら絶対おトモダチに[r]なってくれると信じてたデース！[p]
[_tb_end_text]
; @translation
[tb_start_text mode=1 ]
