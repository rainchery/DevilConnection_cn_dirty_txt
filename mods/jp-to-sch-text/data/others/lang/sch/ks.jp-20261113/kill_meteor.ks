[tb_start_text mode=1 ]
#でびるん
[_tb_end_text]
; @end-dialogue



; @dialogue
; @source
[tb_start_text mode=1 ]
#でびるん
・・・なぁにうつつ抜かしてんだ？[r]てみゃーにおトモダチなんざ必要ねぇだろうが[p]
[_tb_end_text]
; @translation
[tb_start_text mode=1 ]
#でびるん
……发什么呆呢？[r]
你这家伙根本不需要朋友吧．[p]
[_tb_end_text]
; @end-dialogue



; @dialogue
; @source
