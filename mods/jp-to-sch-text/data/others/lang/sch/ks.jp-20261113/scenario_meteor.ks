; @translation
[tb_start_text mode=1 ]
#でびるん
[_tb_end_text]
; @end-dialogue



; @dialogue
; @source
[tb_start_text mode=1 ]
#でびるん
[emb exp="f.name"]とトモダチになれるのが[r]そんなに嬉しいのか…[p]
[_tb_end_text]
; @translation
[tb_start_text mode=1 ]
#でびるん
[emb exp="f.name"]这家伙，和[if exp="f.seibetu == 1]他[else]她[endif]交上朋友[r]
有必要这么地开心吗……[p]
[_tb_end_text]
; @end-dialogue



; @dialogue
; @source
[tb_start_text mode=1 ]
#ミーティア
イエース絶対おトモダチに[r]なってくれると信じてたデース！[p]
[_tb_end_text]
; @translation
[tb_start_text mode=1 ]
#ミーティア
Yes～，小咪坚信，[r]
我们一定能成为伙伴的说！[p]
[_tb_end_text]
; @end-dialogue



; @dialogue
; @source
[tb_start_text mode=1 ]
#ミーティア
[font size=50]ミャァー！やったデス！[r]嬉しいデース！[resetfont][p]

[_tb_end_text]
; @translation
[tb_start_text mode=1 ]
#ミーティア
[font size=50]咪呀～！太棒啦！[r]
好开心的说！[resetfont][p]

[_tb_end_text]
; @end-dialogue



; @dialogue
; @source
[tb_start_text mode=1 ]
#でびるん
あーちょっ…まだ何も言ってねぇだろ！[p]
[_tb_end_text]
; @translation
[tb_start_text mode=1 ]
#でびるん
啊～喂……，我什么都还没说呢！[p]
[_tb_end_text]
; @end-dialogue



; @dialogue
; @source
[tb_start_text mode=1 ]
#ミーティア
[emb exp="f.name"]サンなら絶対おトモダチに[r]なってくれると信じてたデース！[p]
[_tb_end_text]
; @translation
[tb_start_text mode=1 ]
