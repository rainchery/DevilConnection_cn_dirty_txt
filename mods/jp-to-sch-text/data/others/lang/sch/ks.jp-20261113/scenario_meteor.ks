; @source
[tb_start_text mode=1 ]
#ミーティア
[font size=50][emb exp="f.name"]サン！[resetfont][r]やっぱり！夢と同じデース！[p]
[_tb_end_text]
; @translation
[tb_start_text mode=1 ]
#ミーティア
[font size=50][emb exp="f.name"]！[resetfont][r]
哇哦！就和做梦一样的说！[p]
[_tb_end_text]
; @end-dialogue



; @dialogue
