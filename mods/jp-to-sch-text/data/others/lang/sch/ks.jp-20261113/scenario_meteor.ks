; @dialogue
; @source
[tb_start_text mode=1 ]
#ミーティア
[font size=50]ミャァー！やったデス！[r]嬉しいデース！[resetfont][p]


[_tb_end_text]
; @translation
[tb_start_text mode=1 ]
#ミーティア
[font size=50]咪呀～！太棒啦！[r]
好开心的说！[resetfont][p]


