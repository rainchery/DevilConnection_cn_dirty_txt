; @dialogue
; @source
[tb_start_text mode=1 ]
#コニー
な、何をする気でしょう！[r]まずは落ち着いて相手の動向を確認せねば…[p]
[_tb_end_text]
; @translation
[tb_start_text mode=1 ]
#コニー
你、你要干什么！[r]
我必须先冷静下来，确认对方的动向后……[p]
[_tb_end_text]
; @end-dialogue



; @dialogue
; @source
[tb_start_text mode=1 ]
