[_tb_end_text]
; @end-dialogue



; @dialogue
; @source
[tb_start_text mode=1 ]
#でびるん
おみゃーの赤っ恥かいたツラ[r]楽しませてもらうぜ[p]

[_tb_end_text]
; @translation
[tb_start_text mode=1 ]
#でびるん
那就让本大爷来好好地欣赏一下，[r]
你那满脸通红的窘态吧。[p]

[_tb_end_text]
