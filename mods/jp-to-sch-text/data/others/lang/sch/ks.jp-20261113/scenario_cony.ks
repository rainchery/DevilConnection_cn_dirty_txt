; @dialogue
; @source
[tb_start_text mode=1 ]
#でびるん
[ruby text="⠀"]裸体ではなく困惑するその反応に[ruby text="はい"]背[ruby text="とく"]徳[ruby text="かん"]感を感じていた！？[p]
[_tb_end_text]
; @translation
[tb_start_text mode=1 ]
#でびるん
对裸体无关的窘迫反应产生了异样的快感！？[p]
[_tb_end_text]
; @end-dialogue



; @dialogue
; @source
