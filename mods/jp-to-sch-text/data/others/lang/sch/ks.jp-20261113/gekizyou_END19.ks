; @dialogue
; @source
[tb_start_text mode=1 ]
#でびるん
ったく！よりにもよって敏感なツノにクリーム[r]つけやがって…オレサマだって[if exp="f.HANYOU == 1"]もっと[endif]なめたかった…[p]

[_tb_end_text]
; @translation
