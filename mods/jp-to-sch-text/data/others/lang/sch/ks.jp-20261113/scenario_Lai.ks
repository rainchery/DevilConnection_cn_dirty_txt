[_tb_end_text]
; @end-dialogue



; @dialogue
; @source
[tb_start_text mode=1 ]
#ライ
悪魔からみたら…[r]そうなんだ…[p]



[_tb_end_text]
; @translation
[tb_start_text mode=1 ]
