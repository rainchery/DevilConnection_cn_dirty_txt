[_tb_end_text]
; @end-dialogue



; @dialogue
; @source
[tb_start_text mode=1 ]
#でびるん
はーめんどくせ。おみゃーがライオンだろうが何だろうが[r]悪魔のオレサマから見りゃその辺の毛玉の1匹にすぎないぜ[p]

[_tb_end_text]
; @translation
[tb_start_text mode=1 ]
#でびるん
