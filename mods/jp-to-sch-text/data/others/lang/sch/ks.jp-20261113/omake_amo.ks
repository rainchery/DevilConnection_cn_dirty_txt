; @dialogue
; @source
[tb_start_text mode=1 ]
#クピャドエル
くぴゃあ…天使は私欲を捨て無性別になって[r][ruby text="⠀"]はじめて[ruby text="くらい"]位が高くなるのですぅ[p]

[_tb_end_text]
; @translation
[tb_start_text mode=1 ]
#クピャドエル
