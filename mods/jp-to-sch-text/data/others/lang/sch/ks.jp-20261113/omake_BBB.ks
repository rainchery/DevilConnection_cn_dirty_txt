[_tb_end_text]
; @translation
[tb_start_text mode=1 ]
#ニスロク
（[delay speed=80]可恨[delay speed=100]……[resetdelay]可恨可恨可恨[resetdelay]）[p]
[_tb_end_text]
; @end-dialogue



