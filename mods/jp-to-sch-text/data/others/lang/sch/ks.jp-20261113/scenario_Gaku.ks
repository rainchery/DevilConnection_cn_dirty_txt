; @dialogue
; @source
[tb_start_text mode=1 ]
#ガク
ブリキなワケねーだろ！[r]あんだよ[p]
[_tb_end_text]
; @translation
[tb_start_text mode=1 ]
#ガク
什么铁皮机器人！[r]
你说谁呢？[p]
[_tb_end_text]
; @end-dialogue



; @dialogue
; @source
