; @dialogue
; @source
[tb_start_text mode=1 ]
#ネオでびるん
[quake_text]ふん、こやつらが何がしたいのかさっぱりだぜ[free_quake_text][p]
[_tb_end_text]
; @translation
[tb_start_text mode=1 ]
#ネオでびるん
[quake_text]哼，完全搞不懂这两个家伙到底想干什么。[free_quake_text][p]
[_tb_end_text]
; @end-dialogue



; @dialogue
; @source
[tb_start_text mode=1 ]
#ネオでびるん
[quake_text]・・・さてはオレサマのことおちょくってんのか？[free_quake_text][p]
[_tb_end_text]
; @translation
[tb_start_text mode=1 ]
#ネオでびるん
[quake_text]……莫非是在戏耍本大爷？[free_quake_text][p]
[_tb_end_text]
; @end-dialogue



; @dialogue
; @source
[tb_start_text mode=1 ]
#ネオでびるん
[quake_text]ちょ、おい！オレサマの心ん中[r]勝手に覗いてんじゃねーよ！[free_quake_text][p]
[_tb_end_text]
; @translation
[tb_start_text mode=1 ]
#ネオでびるん
[quake_text]啊，喂！你别随随便便就窥视[r]
本大爷的内心！[free_quake_text][p]
[_tb_end_text]
; @end-dialogue



