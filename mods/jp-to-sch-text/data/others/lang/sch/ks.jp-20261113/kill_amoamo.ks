[_tb_end_text]
; @end-dialogue



; @dialogue
; @source
[tb_start_text mode=1 ]
#でびるん
[font face="kowai"][ruby text="⠀"]アスモデウス、おみゃーは[ruby text="たい"]戴[ruby text="かん"]冠[ruby text="しき"]式の時[r]散々オレサマをコケにした[resetfont][p]
[_tb_end_text]
; @translation
[tb_start_text mode=1 ]
#でびるん
[font face="kowai"]阿斯莫德，你在加冕仪式的那天，[r]
可是狠狠地羞辱了本大爷。[resetfont][p]
[_tb_end_text]
; @end-dialogue



; @dialogue
; @source
