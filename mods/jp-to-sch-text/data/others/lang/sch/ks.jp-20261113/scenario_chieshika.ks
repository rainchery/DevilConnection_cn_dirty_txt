#でびるん
[font face="DZUYOKU"][font size=80]やめんか！[resetfont][p]



[_tb_end_text]
; @translation
[tb_start_text mode=1 ]
#でびるん
[font face="DZUYOKU"][font size=80]别看了！[resetfont][p]



[_tb_end_text]
