[_tb_end_text]
; @end-dialogue



; @dialogue
; @source
[tb_start_text mode=1 ]
#D・Red
悪いことをした…[p]
[_tb_end_text]
; @translation
[tb_start_text mode=1 ]
#D・Red
唉，真乃造孽之事……[p]
[_tb_end_text]
; @end-dialogue



; @dialogue
; @source
[tb_start_text mode=1 ]
#D・Red
ベルフェゴール、お前に対しても[r]レヴィアタンの件を謝罪したいと思っている[p]
[_tb_end_text]
; @translation
[tb_start_text mode=1 ]
#D・Red
贝尔芬格，你与利维坦之事，[r]
