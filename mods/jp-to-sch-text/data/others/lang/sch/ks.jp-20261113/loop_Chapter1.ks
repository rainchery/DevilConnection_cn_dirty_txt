[_tb_end_text]
; @translation
[tb_start_text mode=1 ]
#でびるん
[font size=50]嘿、嘿呀！[wait time=300]这、这个……[r]
放……放开我……[resetfont][p]


[_tb_end_text]
; @end-dialogue



; @dialogue
; @source
[tb_start_text mode=1 ]
#でびるん
[font size=50]だぎゃッ！[resetfont][p]


[_tb_end_text]
; @translation
