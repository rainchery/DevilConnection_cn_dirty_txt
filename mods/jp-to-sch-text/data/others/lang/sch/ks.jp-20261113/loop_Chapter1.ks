#①マルス①
[delay speed=100]…………[resetdelay][p]
[_tb_end_text]
; @end-dialogue



; @dialogue
; @source
[tb_start_text mode=1 ]
#①マルス①
そ、それではここいらで失礼いたします[p]
[_tb_end_text]
; @translation
[tb_start_text mode=1 ]
#①マルス①
