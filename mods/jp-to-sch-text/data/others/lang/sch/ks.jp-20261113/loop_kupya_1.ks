[_tb_end_text]
; @translation
[tb_start_text mode=1 ]
#クピャドエル
是在NEO德比君的阶段？[r]
亦或是，重新来过之时？[p]
[_tb_end_text]
; @end-dialogue



; @dialogue
; @source
[tb_start_text mode=1 ]
#クピャドエル
んもう…でびくんは本当に世話の焼ける子ですねぇ[p]
[_tb_end_text]
; @translation
[tb_start_text mode=1 ]
#クピャドエル
